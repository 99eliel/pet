rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pet_grupo6_ranking/{scoreId} {
      // O ranking pode ser lido publicamente com uma consulta limitada.
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 100;

      // Aceita apenas novos resultados com campos esperados.
      // Ainda NÃO impede falsificação de pontuação via console do navegador.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'name', 'score', 'correct', 'total', 'elapsedMs',
          'questionSet', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'score', 'correct', 'total', 'elapsedMs',
          'questionSet', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 28
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 2000
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= 10
        && request.resource.data.total == 10
        && request.resource.data.elapsedMs is int
        && request.resource.data.elapsedMs >= 0
        && request.resource.data.elapsedMs <= 150000
        && request.resource.data.questionSet is string
        && request.resource.data.questionSet.size() <= 40
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
