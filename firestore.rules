rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A feira usa uma senha apenas na interface web.
    // Atenção: essa senha NÃO protege o Firestore; qualquer usuário
    // autenticado anonimamente pode ler tentativas ou iniciar outro placar.
    // Não usar estas regras com dados que exijam acesso restrito.

    function validScore() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'name','score','correct','total','elapsedMs',
          'questionSet','submittedBy','createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name','score','correct','total','elapsedMs',
          'questionSet','submittedBy','createdAt'
        ])
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 28
        && request.resource.data.score is int
        && request.resource.data.correct is int
        && request.resource.data.total == 10
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= 10
        && request.resource.data.score >= request.resource.data.correct * 100
        && request.resource.data.score <= request.resource.data.correct * 200
        && request.resource.data.elapsedMs is int
        && request.resource.data.elapsedMs >= 0
        && request.resource.data.elapsedMs <= 2147483647
        && request.resource.data.questionSet is string
        && request.resource.data.questionSet.size() >= 1
        && request.resource.data.questionSet.size() <= 80
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
    }

    function validAnswer(answer) {
      return answer is map
        && answer.keys().hasOnly(['questionId','correct','elapsedMs'])
        && answer.keys().hasAll(['questionId','correct','elapsedMs'])
        && answer.questionId is string
        && answer.questionId.size() >= 3
        && answer.questionId.size() <= 30
        && answer.correct is bool
        && answer.elapsedMs is int
        && answer.elapsedMs >= 0
        && answer.elapsedMs <= 2147483647;
    }

    function validAnswers(answers) {
      return answers is list && answers.size() == 10
        && validAnswer(answers[0]) && validAnswer(answers[1])
        && validAnswer(answers[2]) && validAnswer(answers[3])
        && validAnswer(answers[4]) && validAnswer(answers[5])
        && validAnswer(answers[6]) && validAnswer(answers[7])
        && validAnswer(answers[8]) && validAnswer(answers[9]);
    }

    // Trocar a edição ativa zera o placar visível SEM excluir documentos
    // anteriores nem as respostas históricas para pesquisa.
    match /pet_grupo6_controle/placar {
      allow get: if true;
      allow list, delete: if false;
      // Liberado a qualquer usuário do quiz autenticado anonimamente.
      // Não há cadastro de administrador nem validação do PIN pelo servidor.
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['sessionId','resetAt','resetBy'])
        && request.resource.data.keys().hasAll(['sessionId','resetAt','resetBy'])
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.matches('^ed-[A-Za-z0-9_-]{12,60}$')
        && request.resource.data.resetBy == request.auth.uid
        && request.resource.data.resetAt == request.time;
    }

    // Preserva o placar existente antes do primeiro reset.
    match /pet_grupo6_ranking/{scoreId} {
      allow list: if request.query.limit != null && request.query.limit <= 100;
      allow get: if signedIn() && resource.data.submittedBy == request.auth.uid;
      allow create: if scoreId.size() >= 15 && scoreId.size() <= 80 && validScore();
      allow update, delete: if false;
    }

    // A partir do reset, cada nova edição tem seu ranking isolado.
    match /pet_grupo6_placares/{sessionId}/entradas/{scoreId} {
      allow list: if request.query.limit != null && request.query.limit <= 100;
      allow get: if signedIn() && resource.data.submittedBy == request.auth.uid;
      allow create: if sessionId.matches('^ed-[A-Za-z0-9_-]{12,60}$')
        && scoreId.size() >= 15 && scoreId.size() <= 80
        && validScore();
      allow update, delete: if false;
    }

    // Um documento por partida concluída. SEM nome, CPF, telefone ou foto.
    // Para relatório sem login administrativo, a consulta é liberada a
    // usuários anônimos. Idades e respostas individuais ficam acessíveis
    // via Firestore: coletar idade somente se o participante desejar.
    match /pet_grupo6_tentativas/{attemptId} {
      allow list: if signedIn()
        && request.query.limit != null
        && request.query.limit <= 250;
      allow get: if signedIn() && resource.data.submittedBy == request.auth.uid;
      allow create: if signedIn()
        && attemptId.size() >= 15 && attemptId.size() <= 80
        && request.resource.data.keys().hasOnly([
          'sessionId','questionSet','total','correct','answers','submittedBy','createdAt','age'
        ])
        && request.resource.data.keys().hasAll([
          'sessionId','questionSet','total','correct','answers','submittedBy','createdAt'
        ])
        && request.resource.data.sessionId is string
        && (
          request.resource.data.sessionId == 'legado'
          || request.resource.data.sessionId.matches('^ed-[A-Za-z0-9_-]{12,60}$')
        )
        && request.resource.data.questionSet is string
        && request.resource.data.questionSet.size() >= 1
        && request.resource.data.questionSet.size() <= 80
        && request.resource.data.total == 10
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= 10
        // Optional para não rejeitar tentativas antigas que estão offline,
        // antes de o cadastro de idade ter sido publicado.
        && (
          !request.resource.data.keys().hasAny(['age'])
          || (request.resource.data.age is int
            && request.resource.data.age >= 1
            && request.resource.data.age <= 120)
        )
        && request.resource.data.submittedBy == request.auth.uid
        && validAnswers(request.resource.data.answers)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
